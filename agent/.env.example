# Copy to .env and fill in (never commit .env)
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AGENT_OPENAI_BASE=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_EFFORT=low
AGENT_HARNESS=http
# http (default, fast) | auto (Claude Code then HTTP) | claude-code
AGENT_THINKING=disabled
AGENT_CLAUDE_TIMEOUT=90
AGENT_CLAUDE_MAX_RETRIES=3
AGENT_RAG_BUDGET=3500
AGENT_STREAM_PROCESS=1
AGENT_CC_TOOLS=Read,Glob,Grep,WebSearch,WebFetch
# Optional extra --add-dir paths (comma-separated)
# AGENT_CC_ADD_DIRS=/path/to/more
PORT=8788
AGENT_ALLOWED_ORIGINS=https://darkness-hy.github.io,https://hongyuding.site,https://www.hongyuding.site,http://127.0.0.1:8000,http://localhost:8000
