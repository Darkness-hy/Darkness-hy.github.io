# Copy to .env and fill in (never commit .env)
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AGENT_OPENAI_BASE=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_EFFORT=low
AGENT_HARNESS=auto
