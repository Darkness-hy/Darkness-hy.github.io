DEEPSEEK_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
AGENT_OPENAI_BASE=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_EFFORT=low
# claude-code | http | auto
AGENT_HARNESS=http
AGENT_THINKING=disabled
AGENT_CLAUDE_TIMEOUT=90
AGENT_CLAUDE_MAX_RETRIES=3
AGENT_RAG_BUDGET=3500
AGENT_STREAM_PROCESS=1
# Built-in CC tools (default empty). MCP web_search/web_fetch always on.
# Do NOT enable Glob/Grep on shared hosts. Read only if you accept FS exposure.
AGENT_CC_TOOLS=
AGENT_CC_ADD_DIR=0
AGENT_CC_ADD_DIRS=
AGENT_SURVEY_PREFETCH=0
AGENT_URL_PREFETCH=1
# Chat audit: store full message+reply per IP (admin UI at /admin)
AGENT_LOG_CHAT=1
# Legacy alias for full fields (prefer LOG_CHAT)
AGENT_LOG_FULL=0
# Password for https://agent.example/admin (no token)
AGENT_ADMIN_PASSWORD=
PORT=8788
AGENT_ALLOWED_ORIGINS=https://darkness-hy.github.io,https://hongyuding.site,https://www.hongyuding.site,http://127.0.0.1:8000,http://localhost:8000
# --- Cost / abuse limits (defaults are conservative for a public homepage) ---
# AGENT_MAX_CONCURRENCY=2
# AGENT_MAX_QUEUE=8
# AGENT_RATE_PER_MIN=6
# AGENT_RATE_PER_HOUR=25
# AGENT_RATE_PER_DAY=40
# AGENT_RATE_GLOBAL_PER_MIN=30
# AGENT_RATE_GLOBAL_PER_DAY=500
# AGENT_RATE_COOLDOWN_S=2
# AGENT_MSG_MAX_CHARS=2000
# AGENT_HISTORY_TURNS=8
# AGENT_HTTP_TOOL_ROUNDS=3
# AGENT_QUOTA_FILE=/var/lib/xixi/logs/quota.json
# Isolation (set by setup_xixi.sh when running as user xixi):
# AGENT_KNOWLEDGE_DIR=/var/lib/xixi/knowledge
# AGENT_LOG_DIR=/var/lib/xixi/logs
# Optional general web (academic Wikipedia/arXiv/OpenAlex/Crossref need no key):
# BRAVE_API_KEY=
# SERPER_API_KEY=
# SEARXNG_URL=https://searx.example.com
